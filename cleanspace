#!/usr/bin/env bash
# cleanspace: free disk space on macOS and Linux without losing anything you care about.
#
# Usage: cleanspace [options]          (the installer also sets up the alias: clean)
#   (no option)       scan, show what can go and how each item comes back, ask, then clean
#   --deep [dir]      also browser caches, idle app caches, the Trash, and build folders
#                     (node_modules, target, ...) of projects under dir or your code folders
#   --older DAYS      with --deep, keep builds of projects edited in the last DAYS days (default 14)
#   -n, --dry-run     show the plan only, delete nothing
#   -y, --yes         clean without asking (needed when not run from a terminal)
#   --review          go through personal space hogs one at a time, asking before each
#   --stats           space freed so far, and which caches grow back fastest
#   --schedule [daily|weekly|off]
#                     clean automatically whenever free space drops below a limit (default 20G)
#   --auto            what the schedule runs: clean only if free space is below the limit
#   --config          show the config file (exclusions, code folders, limits), creating it if needed
#   --update          update to the latest version
#   --remove          uninstall cleanspace with its schedule, settings and history
#   --version, -h, --help
#
# Exit codes: 0 done, 1 error, 2 confirmation needed (no terminal, use --yes), 130 interrupted.

VERSION=2.2.0
unset GUARD GUARDF BACK SIZE NEEDCMD   # item() reads these; never inherit them
RAW=https://raw.githubusercontent.com/Pantho-Haque/cleanspace/main
JOB=io.github.pantho-haque.cleanspace
OS=$(uname -s)
SELF=$(command -v -- "$0" 2>/dev/null) || SELF=$0
case $SELF in /*) ;; *) SELF=$PWD/$SELF ;; esac
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/cleanspace
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/cleanspace/config
HIST=$STATE/history.tsv
T='~'

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  G=$'\e[32m' Y=$'\e[33m' RED=$'\e[31m' D=$'\e[2m' B=$'\e[1m' R=$'\e[0m' EL=$'\r\e[K'
else
  G= Y= RED= D= B= R= EL=
fi
VIS=; [ -t 1 ] && VIS=1                     # animate (spinner, scan progress)
IN=${CLEANSPACE_INPUT:-/dev/tty}            # where answers come from (tests point this at a file)
ASK=; { [ -t 1 ] || [ -n "${CLEANSPACE_INPUT:-}" ]; } && { : <"$IN"; } 2>/dev/null && ASK=1

die()  { echo "${RED}cleanspace:${R} $*" >&2; exit 1; }
warn() { echo "${Y}!${R} $*" >&2; }
ok()   { echo "${G}✓${R} $*"; }
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; printf %s "${s%"${s##*[![:space:]]}"}"; }

# ---------------------------------------------------------------- arguments
DEEP= DRY= YES= AUTO= ACTION= SCHED= OLDER= DIRS=()
while [ $# -gt 0 ]; do
  case $1 in
    --deep) DEEP=1
            if [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; then
              [ -d "$2" ] || die "no such folder: $2"; DIRS+=("${2%/}"); shift
            fi ;;
    --older) [[ ${2:-} =~ ^[0-9]+$ ]] || die "--older needs a number of days"; OLDER=$2; shift ;;
    -n|--dry-run) DRY=1 ;;
    -y|--yes) YES=1 ;;
    --auto) AUTO=1 YES=1 ;;
    --schedule) ACTION=$1
                case ${2:-} in daily|weekly|off) SCHED=$2; shift ;; *) SCHED=daily ;; esac ;;
    --review|--stats|--config|--update|--remove|--version|-h|--help) ACTION=$1 ;;
    *) die "unknown option: $1 (see cleanspace --help)" ;;
  esac
  shift
done

# ---------------------------------------------------------------- config
EXCL=() CDIRS=() AUTO_GB=20 OLDER_CONF=14
if [ -f "$CONF" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in \#*|"") continue ;; *=*) ;; *) warn "config: ignoring '$line'"; continue ;; esac
    k=$(trim "${line%%=*}") v=$(trim "${line#*=}")
    # shellcheck disable=SC2088  # a literal ~ from the file, expanded by hand
    case $v in "~"|"~/"*) v=$HOME${v#"~"} ;; esac
    case $k in
      exclude)       EXCL+=("${v%/}") ;;
      deep_dir)      CDIRS+=("${v%/}") ;;
      older_days)    [[ $v =~ ^[0-9]+$ ]] && OLDER_CONF=$v || warn "config: older_days must be a number" ;;
      auto_below_gb) [[ $v =~ ^[0-9]+$ ]] && AUTO_GB=$v || warn "config: auto_below_gb must be a number" ;;
      *) warn "config: unknown setting '$k'" ;;
    esac
  done < "$CONF"
fi
OLDER=${OLDER:-$OLDER_CONF}
# Keep the schedule's copy of the script (see schedule) in step with this one, e.g. after a git pull.
[ -z "$AUTO" ] && [ -f "$STATE/cleanspace" ] && [ "$SELF" != "$STATE/cleanspace" ] && ! cmp -s "$SELF" "$STATE/cleanspace" &&
  cp "$SELF" "$STATE/cleanspace"

if [ "$OS" = Darwin ]; then
  C=$HOME/Library/Caches S=$HOME/Library/Application\ Support PNPM=$HOME/Library/pnpm/store YARN=Yarn
else
  C=${XDG_CACHE_HOME:-$HOME/.cache} S=${XDG_CONFIG_HOME:-$HOME/.config} PNPM=$HOME/.local/share/pnpm/store YARN=yarn
fi
# Everything under C and S counts as deletable, so a cache or config dir set to /, home, or a parent of home is ignored.
for v in C S; do
  case "$HOME/" in "${!v%/}"/*)
    if [ $v = C ]; then warn "ignoring XDG_CACHE_HOME=$C: it must be its own folder"; C=$HOME/.cache
    else warn "ignoring XDG_CONFIG_HOME=$S: it must be its own folder"; S=$HOME/.config; fi ;;
  esac
done

# ---------------------------------------------------------------- helpers
kb()       { [ $# -gt 0 ] || { echo 0; return; }; du -sk "$@" 2>/dev/null | awk '{s+=$1} END {print s+0}'; }
human()    { awk -v k="$1" 'BEGIN { if (k>=1073741824) printf "%.1fT", k/1073741824; else if (k>=1048576) printf "%.1fG", k/1048576;
                                    else if (k>=1024) printf "%.0fM", k/1024; else printf "%dK", k }'; }
freekb()   { df -Pk "$HOME" | awk 'NR==2 {print $4}'; }
diskfree() { df -Ph "$HOME" | awk 'NR==2 {print $4 " free (" $5 " used)"}'; }
tilde()    { printf %s "${1/#$HOME/$T}"; }
recent()   { [ -n "$(find "$1" -maxdepth 3 -mtime -"$2" -print -quit 2>/dev/null)" ]; }   # anything in $1 changed in $2 days?

SPID= LOCKED= RUNNING= total=0
spin() {   # spin "message" cmd...: run cmd quietly, with a spinner on a terminal. Returns cmd's status.
  local msg=$1; shift
  if [ -z "$VIS" ]; then "$@" >/dev/null 2>&1; return; fi
  local f=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) i=0
  "$@" >/dev/null 2>&1 & SPID=$!
  while kill -0 "$SPID" 2>/dev/null; do printf "\r  ${Y}%s${R} %s" "${f[i++ % 10]}" "$msg"; sleep 0.1; done
  wait "$SPID"; local rc=$?; SPID=; return $rc
}
progress() { [ -n "$VIS" ] && printf "%s  ${D}scanning %s…${R}" "$EL" "$1"; }

lock() {
  mkdir -p "$STATE" || die "cannot create $STATE"
  if ! mkdir "$STATE/lock" 2>/dev/null; then
    local pid; pid=$(cat "$STATE/lock/pid" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && die "another cleanspace is already running (pid $pid)"
    rm -rf "$STATE/lock"; mkdir "$STATE/lock" || die "cannot lock $STATE"
  fi
  echo $$ > "$STATE/lock/pid"; LOCKED=1
}
cleanup() { [ -n "$SPID" ] && kill "$SPID" 2>/dev/null; [ -n "$LOCKED" ] && rm -rf "$STATE/lock"; [ ${#REOPEN[@]} -gt 0 ] && reopen; }
interrupted() {
  [ -n "$SPID" ] && kill "$SPID" 2>/dev/null; SPID=
  printf "%s\n${Y}Interrupted.${R}" "$EL"
  if [ -n "$RUNNING" ]; then
    printf " Freed so far: ${B}%s${R}" "$(human $total)"
    [ -n "$HROWS" ] && printf %s "$HROWS" >> "$HIST"
  fi
  echo
  exit 130
}
trap cleanup EXIT
trap interrupted INT TERM

notify() {
  if [ "$OS" = Darwin ]; then
    osascript -e 'on run a' -e 'display notification (item 1 of a) with title "cleanspace"' -e 'end run' "$1" >/dev/null 2>&1
  else command -v notify-send >/dev/null && notify-send cleanspace "$1" 2>/dev/null; fi
}

# Answer y/N. Always "no" in a dry run.
ask() {
  [ -z "$DRY" ] || { echo "$1 [dry run: no]"; return 1; }
  local a; printf "%s [y/N] " "$1"; read -r a <"$IN" || return 1
  [ "$a" = y ] || [ "$a" = Y ] || [ "$a" = yes ]
}

totrash() {
  if [ -x /usr/bin/trash ]; then /usr/bin/trash "$1"                     # macOS 15+
  elif [ "$OS" = Darwin ]; then
    osascript -e 'on run a' -e 'tell application "Finder" to delete POSIX file (item 1 of a)' -e 'end run' "$1" >/dev/null
  elif command -v gio >/dev/null; then gio trash "$1"
  else mkdir -p ~/.local/share/Trash/files && mv "$1" ~/.local/share/Trash/files/; fi
}

# ---------------------------------------------------------------- simple actions
schedule() {
  local when=$1 cron
  if [ "$OS" = Darwin ]; then
    local plist=$HOME/Library/LaunchAgents/$JOB.plist wd= prog=$SELF real=$SELF l
    launchctl bootout "gui/$(id -u)/$JOB" 2>/dev/null; rm -f "$plist" "$STATE/cleanspace"
    [ "$when" = off ] && return
    [ "$when" = weekly ] && wd='<key>Weekday</key><integer>1</integer>'
    mkdir -p "$HOME/Library/LaunchAgents" "$STATE"
    while [ -L "$real" ]; do l=$(readlink "$real"); case $l in /*) real=$l ;; *) real=${real%/*}/$l ;; esac; done
    # macOS privacy rules stop launchd jobs reading ~/Desktop, ~/Documents, ~/Downloads and iCloud Drive
    # ("Operation not permitted"), so a script kept there is run from a copy, refreshed by every manual run.
    case $real in "$HOME"/Desktop/*|"$HOME"/Documents/*|"$HOME"/Downloads/*|"$HOME/Library/Mobile Documents"/*)
      prog=$STATE/cleanspace; cp "$real" "$prog" && chmod +x "$prog" || die "cannot copy the script to $prog" ;;
    esac
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$JOB</string>
  <key>ProgramArguments</key><array><string>$prog</string><string>--auto</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$PATH</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer>$wd</dict>
  <key>StandardOutPath</key><string>$STATE/auto.log</string>
  <key>StandardErrorPath</key><string>$STATE/auto.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict></plist>
EOF
    launchctl bootstrap "gui/$(id -u)" "$plist" || die "launchctl could not load $plist"
    return
  fi
  local units=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
  if [ -f "$units/cleanspace.timer" ]; then
    systemctl --user disable --now cleanspace.timer >/dev/null 2>&1; rm -f "$units"/cleanspace.service "$units"/cleanspace.timer
    systemctl --user daemon-reload 2>/dev/null
  fi
  if command -v crontab >/dev/null && crontab -l 2>/dev/null | grep -q '# cleanspace$'; then
    crontab -l 2>/dev/null | grep -v '# cleanspace$' | crontab -
  fi
  [ "$when" = off ] && return
  if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    mkdir -p "$units" "$STATE"
    printf '[Unit]\nDescription=cleanspace: clean caches when disk space is low\n\n[Service]\nType=oneshot\nEnvironment="PATH=%s"\nExecStart="%s" --auto\nNice=10\nIOSchedulingClass=idle\nStandardOutput=append:%s\nStandardError=append:%s\n' \
      "$PATH" "$SELF" "$STATE/auto.log" "$STATE/auto.log" > "$units/cleanspace.service"
    printf '[Unit]\nDescription=cleanspace %s check\n\n[Timer]\nOnCalendar=%s\nPersistent=true\nRandomizedDelaySec=1h\n\n[Install]\nWantedBy=timers.target\n' \
      "$when" "$when" > "$units/cleanspace.timer"
    systemctl --user daemon-reload && systemctl --user enable --now cleanspace.timer >/dev/null 2>&1 ||
      die "systemctl could not enable the timer"
  elif command -v crontab >/dev/null; then
    mkdir -p "$STATE"
    [ "$when" = weekly ] && cron='0 11 * * 1' || cron='0 11 * * *'
    { crontab -l 2>/dev/null; echo "$cron PATH='$PATH' '$SELF' --auto >> '$STATE/auto.log' 2>&1 # cleanspace"; } | crontab - ||
      die "crontab could not be updated"
  else
    die "no systemd user session or cron found to schedule with"
  fi
}

schedule_status() {
  local f
  if [ "$OS" = Darwin ]; then f=$HOME/Library/LaunchAgents/$JOB.plist
    [ -f "$f" ] || { echo off; return; }
    grep -q Weekday "$f" && echo weekly || echo daily
  elif [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/cleanspace.timer" ]; then
    sed -n 's/^OnCalendar=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/cleanspace.timer"
  elif crontab -l 2>/dev/null | grep -q '# cleanspace$'; then
    crontab -l | grep -q '^0 11 \* \* 1 ' && echo weekly || echo daily
  else echo off; fi
}

stats() {
  echo "${B}cleanspace stats${R}"
  local s; s=$(schedule_status)
  if [ "$s" = off ]; then echo "  Schedule: off  ${D}(turn on with: cleanspace --schedule)${R}"
  else echo "  Schedule: $s, cleans when free space is below ${AUTO_GB}G  ${D}(log: $(tilde "$STATE/auto.log"))${R}"; fi
  [ -s "$HIST" ] || { echo "  No cleans recorded yet. Run clean to start."; return; }
  local summary first runs freed
  # FS: tabs, or the 4 spaces that versions before 2.2 wrote by mistake
  summary=$(awk -F'\t|    ' '{ runs[$1]=1; tot+=$4; if (!first || $1<first) first=$1 } END { n=0; for (r in runs) n++; print n, tot, first }' "$HIST")
  read -r runs freed first <<< "$summary"
  first=$(date -r "$first" +%F 2>/dev/null || date -d "@$first" +%F)
  echo "  Freed ${G}${B}$(human "$freed")${R} over $runs cleans since $first"
  echo; echo "${B}Biggest wins${R}"
  awk -F'\t|    ' '{ f[$2]+=$4 } END { for (l in f) if (f[l] > 0) printf "%d\t%s\n", f[l], l }' "$HIST" | sort -rn | head -5 |
    while IFS=$'\t' read -r k l; do printf "  %-30s %7s\n" "$l" "$(human "$k")"; done
  # Regrowth: what an item had grown back to at each clean, divided by the time since the clean before.
  local grow
  grow=$(awk -F'\t|    ' '{ if ($2 in last && $1 > last[$2]) { g[$2]+=$3; dt[$2]+=$1-last[$2] } last[$2]=$1 }
    END { for (l in g) if (dt[l] >= 86400 && g[l] > 0) printf "%d\t%s\n", g[l]/dt[l]*604800, l }' "$HIST" | sort -rn | head -5)
  echo; echo "${B}Fastest to grow back${R}  ${D}(per week, measured between cleans)${R}"
  if [ -z "$grow" ]; then echo "  ${D}needs two cleans at least a day apart${R}"
  else while IFS=$'\t' read -r k l; do printf "  %-30s %7s/week\n" "$l" "$(human "$k")"; done <<< "$grow"; fi
}

case $ACTION in
  -h|--help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$SELF"; exit ;;
  --version) echo "cleanspace $VERSION"; exit ;;
  --stats) stats; exit ;;
  --config)
    if [ ! -f "$CONF" ]; then
      mkdir -p "$(dirname "$CONF")" && cat > "$CONF" <<'EOF'
# cleanspace settings. One "key = value" per line; lines starting with # are ignored.

# Never touch something. Matches an item's name (as shown in the plan) or a path, and
# accepts * wildcards. Repeat the line for more.
# exclude = Docker images & build cache
# exclude = ~/Library/Caches/com.spotify.client
# exclude = ~/code/keep-this-project/*

# Folders --deep searches for project build folders. Repeat for more.
# Default: whichever of ~/Desktop ~/Documents ~/Developer ~/code ~/dev ~/projects ~/src ~/repos ~/work exist.
# deep_dir = ~/code

# With --deep, keep builds of projects edited in the last N days (0 = clean all).
# older_days = 14

# The schedule (cleanspace --schedule) only cleans when free space is below this many GB.
# auto_below_gb = 20
EOF
      ok "created $(tilde "$CONF")"
    fi
    echo "Config file: $(tilde "$CONF")  ${D}(edit it with: \${EDITOR:-nano} $(tilde "$CONF"))${R}"; echo
    grep -v '^#' "$CONF" | grep . || echo "${D}(everything is commented out, so the defaults apply)${R}"
    exit ;;
  --schedule)
    if [ "$SCHED" = off ]; then schedule off; ok "schedule removed"; exit; fi
    schedule "$SCHED"
    ok "cleanspace will check $SCHED and clean caches when free space is below ${AUTO_GB}G"
    echo "  ${D}It never touches --deep or --review items. Change the limit with cleanspace --config; stop with --schedule off.${R}"
    exit ;;
  --update)
    if [ -L "$SELF" ]; then   # dev install: symlink into a git checkout
      git -C "$(dirname "$(readlink "$SELF")")" pull --ff-only || die "git pull failed"
      ok "updated checkout"; exit
    fi
    tmp=$SELF.tmp.$$
    curl -fsSL "$RAW/cleanspace" -o "$tmp" || { rm -f "$tmp"; die "download failed"; }
    new=$(sed -n 's/^VERSION=//p' "$tmp" | head -1)
    if [ -z "$new" ] || ! bash -n "$tmp" 2>/dev/null; then rm -f "$tmp"; die "downloaded file looks broken, kept $VERSION"; fi
    [ "$new" = "$VERSION" ] && { rm -f "$tmp"; ok "already up to date ($VERSION)"; exit; }
    chmod +x "$tmp" && mv -f "$tmp" "$SELF" || { rm -f "$tmp"; die "could not replace $SELF"; }
    ok "updated cleanspace $VERSION → $new"; exit ;;
  --remove)
    [ "$(schedule_status)" = off ] || schedule off
    rm -rf "$STATE" "$(dirname "$CONF")"
    for rc in ~/.zshrc ~/.bashrc ~/.bash_profile; do
      [ -f "$rc" ] && grep -q '# cleanspace$' "$rc" || continue
      grep -v '# cleanspace$' "$rc" > "$rc.tmp"; cat "$rc.tmp" > "$rc"; rm -f "$rc.tmp"
    done
    rm -f "$SELF"
    ok "cleanspace removed with its schedule, settings and history (open a new shell to drop the 'clean' alias)"; exit ;;
esac

# ---------------------------------------------------------------- scanning
# Every item is measured first; nothing is deleted until the plan is confirmed.
# Arrays per item: L label, SEC section, K size in KB, ST status, WHY reason, BK how it comes back,
# P paths (newline-separated), CMD the tool's own clean command (\x1f-separated).
N=0 SECT= SBACK= COV=() ROOTS=()

section() { SECT=$1 SBACK=$2; }

excluded() {   # is this label or path excluded in the config?
  local pat hit=1
  [ ${#EXCL[@]} -gt 0 ] || return 1
  shopt -s nocasematch
  for pat in "${EXCL[@]}"; do
    # shellcheck disable=SC2254
    case $1 in $pat|$pat/*) hit=0; break ;; esac
    case $pat in "$1"/*) hit=0; break ;; esac        # an excluded path inside this one: keep the whole thing
  done
  shopt -u nocasematch
  return $hit
}

safe_path() {  # only ever delete inside home, the cache/config dirs, or folders given to --deep
  local r
  case $1 in ""|/|"$HOME"|*/../*|*/..|*/.) return 1 ;; "$HOME"/*|"$C"/*|"$S"/*) return 0 ;; esac
  for r in "${ROOTS[@]}"; do case $1 in "$r"/*) return 0 ;; esac; done
  return 1
}

# [GUARD=process] [GUARDF=pattern] [BACK=kind] [SIZE=kb] [NEEDCMD=1] item "label" path... [-- tool clean command...]
#   GUARD    skip while that process runs     GUARDF  skip while any command line contains pattern
#   BACK     how it comes back: auto | dl | build | gone | manual:<command to get it back>
#   SIZE     size when there are no paths     NEEDCMD  skip unless the tool's own command is installed
item() {
  local label=$1 paths=() cmd=() p had=0 k st=todo why= run=
  shift
  while [ $# -gt 0 ] && [ "$1" != -- ]; do
    p=${1%/}; had=1
    case $'\n'"${paths[*]}"$'\n' in *$'\n'"$p"$'\n'*) shift; continue ;; esac     # listed twice
    if safe_path "$p" && ! excluded "$p"; then paths+=("$p"); COV+=("$p"); fi
    shift
  done
  [ "${1:-}" = -- ] && { shift; cmd=("$@"); }
  progress "$label"
  k=${SIZE:-$(kb "${paths[@]}")}
  if excluded "$label" || { [ $had = 1 ] && [ ${#paths[@]} = 0 ]; }; then st=excluded
  elif [ "${k:-0}" -eq 0 ]; then st=clean
  elif [ -n "${GUARD:-}" ] && pgrep -x "$GUARD" >/dev/null 2>&1; then st=skip why="$GUARD is running" run=$GUARD
  elif [ -n "${GUARDF:-}" ] && pgrep -f -- "$GUARDF" >/dev/null 2>&1; then st=skip why="a running program uses it"
  elif [ -n "${NEEDCMD:-}" ] && ! command -v "${cmd[0]}" >/dev/null; then st=skip why="${cmd[0]} is not on PATH"
  elif [ -n "$AUTO" ]; then case ${BACK:-$SBACK} in manual:*) st=skip why="needs a manual reinstall, so the schedule leaves it" ;; esac
  fi
  L[N]=$label SEC[N]=$SECT K[N]=${k:-0} ST[N]=$st WHY[N]=$why BK[N]=${BACK:-$SBACK} RUN[N]=$run
  local IFS=$'\n'; P[N]="${paths[*]}"
  IFS=$'\x1f'; CMD[N]="${cmd[*]}"
  N=$((N + 1))
}

# item, with paths read from stdin, one per line.  Usage: collect "label" < <(cmd)
collect() { local label=$1 p a=(); while IFS= read -r p; do a+=("$p"); done; item "$label" "${a[@]}"; }

# Entries of dir $1 except the newest $2 and except path $3.
older() {
  [ -d "$1" ] || return
  ls -t "$1" | tail -n +$(( $2 + 1 )) | while IFS= read -r v; do [ "$1/$v" != "$3" ] && echo "$1/$v"; done
}

# JetBrains keeps a cache folder per IDE version (WebStorm2024.3, WebStorm2025.1, ...); keep the newest of each.
old_jetbrains() {
  [ -d "$1" ] || return
  ls -t "$1" | while IFS= read -r v; do
    p=$(printf %s "$v" | sed 's/[0-9.]*$//')
    case " $seen " in *" $p "*) echo "$1/$v" ;; *) seen="$seen $p" ;; esac
  done
}

# Chromium cache folders inside a browser's profile folder. Only these named leaves: never the profile itself.
chromium_leaves() {
  local ud=$1 d n
  [ -d "$ud" ] || return
  for n in ShaderCache GrShaderCache GraphiteDawnCache component_crx_cache; do echo "$ud/$n"; done
  for d in "$ud"/Default "$ud"/Profile\ * "$ud"/Guest\ Profile; do
    [ -d "$d" ] || continue
    for n in Cache "Code Cache" GPUCache DawnCache GrShaderCache GraphiteDawnCache DawnGraphiteCache DawnWebGPUCache "Application Cache"; do
      echo "$d/$n"; done
  done
}

# Electron/Chromium app caches one level inside the app support folder (Slack, Discord, VS Code, Postman, ...).
# A plain "Cache" or "CachedData" only counts when a Chromium marker folder sits next to it (as Mole does),
# so a non-Electron app's own folder called Cache is left alone.
electron_caches() {
  local app n
  for app in "$S"/*/; do
    app=${app%/}
    [ -d "$app/Code Cache" ] || [ -d "$app/GPUCache" ] || [ -d "$app/DawnCache" ] || [ -d "$app/DawnGraphiteCache" ] ||
      [ -d "$app/GrShaderCache" ] || continue
    for n in Cache "Code Cache" GPUCache CachedData CachedExtensionVSIXs DawnCache DawnGraphiteCache GraphiteDawnCache \
             DawnWebGPUCache GrShaderCache ShaderCache Crashpad/completed; do
      [ -d "$app/$n" ] && echo "$app/$n"
    done
  done
}

# Editor extensions VS Code / Cursor have marked obsolete (replaced by a newer version) in extensions/.obsolete.
obsolete_extensions() {
  local dir k
  for dir in ~/.vscode/extensions ~/.vscode-insiders/extensions ~/.cursor/extensions ~/.windsurf/extensions; do
    [ -f "$dir/.obsolete" ] || continue
    grep -oE '"[^"/]+"[[:space:]]*:[[:space:]]*true' "$dir/.obsolete" | sed 's/^"//; s/".*//' |
      while IFS= read -r k; do [ -n "$k" ] && [ -d "$dir/$k" ] && echo "$dir/$k"; done
  done
}

# Cache folders no other item covers and that nothing has touched for a week (so the app is idle).
idle_caches() {
  local e r name
  for e in "$C"/*; do
    [ -d "$e" ] || continue
    name=${e##*/}
    case $name in   # Apple's own, AI models, and apps whose "cache" holds data or licences (Mole's protection list)
      com.apple.*|CloudKit*|huggingface|torch|ollama|llama.cpp|JetBrains|com.jetbrains.*|pip|pypoetry|uv|go-build|pnpm|\
      ms-playwright|kitty|tealdeer|org.R-project.R|com.nssurge.*|app.cotypist.*|com.displaylink.*|com.lasersoft-imaging.*|\
      GIPPseudonymousID|CCTClearcutLogger|com.1password.*|com.agilebits.*|com.bitwarden.*|*keepassxc*) continue ;;
    esac
    if [ "$OS" = Darwin ]; then case $name in *.*) ;; *) continue ;; esac; fi   # bundle ids only, not system folders
    for r in "${COV[@]}"; do case $r in "$e"|"$e"/*) continue 2 ;; esac; done
    recent "$e" 7 && continue
    echo "$e"
  done
}

docker_kb() {  # reclaimable image + build cache size (docker reports SI units)
  docker system df --format '{{.Type}}\t{{.Reclaimable}}' 2>/dev/null | awk -F'\t' '$1 ~ /Images|Build/ {
    v=$2; sub(/ .*/, "", v); n=v+0; u=v; gsub(/[0-9.]/, "", u)
    m = u=="kB" || u=="KB" ? 1e3 : u=="MB" ? 1e6 : u=="GB" ? 1e9 : u=="TB" ? 1e12 : 1
    s += n*m/1024 } END { printf "%d", s }'
}

# ponytail: a folder named like a build folder is never searched inside, so projects nested under e.g. a "bin" folder are missed.
BUILD_NAMES="node_modules .next .nuxt .svelte-kit .angular .astro .expo .metro .turbo .parcel-cache target .xwin-cache .gradle build
  cmake-build-debug cmake-build-release Pods vendor .dart_tool .build .zig-cache zig-cache zig-out _build .elixir_ls .elixir-tools
  .lexical .stack-work dist-newstyle elm-stuff bin obj Library Temp Binaries Intermediate DerivedDataCache .godot .terraform .pixi
  .terragrunt-cache .output coverage DerivedData .cxx .venv venv __pycache__ .pytest_cache .mypy_cache .ruff_cache .tox .nox __pypackages__"
PY_CACHES=" __pycache__ .pytest_cache .mypy_cache .ruff_cache .tox .nox __pypackages__ "
any() { [ -e "$1" ]; }   # any "$dir"/*.csproj: does the glob match something?

# Does a project file that owns this build folder sit next to it? (So a random "target" or "vendor" is never touched.)
owned() {
  local p=$2
  case $1 in
    node_modules|.next|.nuxt|.output|.svelte-kit|.angular|.astro|.expo|.metro|.turbo|.parcel-cache|coverage) [ -f "$p/package.json" ] ;;
    DerivedData)          any "$p"/*.xcodeproj || any "$p"/*.xcworkspace ;;
    .cxx)                 any "$p"/build.gradle* ;;                                  # React Native / Android NDK
    .terragrunt-cache)    [ -f "$p/terragrunt.hcl" ] ;;
    target)               [ -f "$p/Cargo.toml" ] || [ -f "$p/pom.xml" ] || [ -f "$p/build.sbt" ] ;;
    .xwin-cache)          [ -f "$p/Cargo.toml" ] ;;
    .gradle)              any "$p"/build.gradle* || any "$p"/settings.gradle* ;;
    build)                any "$p"/build.gradle* || [ -f "$p/CMakeLists.txt" ] || [ -f "$p/pubspec.yaml" ] ;;
    cmake-build-*)        [ -f "$p/CMakeLists.txt" ] ;;
    Pods)                 [ -f "$p/Podfile" ] ;;
    vendor)               [ -f "$p/composer.json" ] ;;
    .dart_tool)           [ -f "$p/pubspec.yaml" ] ;;
    .build)               [ -f "$p/Package.swift" ] ;;
    .zig-cache|zig-cache|zig-out) [ -f "$p/build.zig" ] ;;
    _build|.elixir_ls|.elixir-tools|.lexical) [ -f "$p/mix.exs" ] ;;
    .stack-work)          [ -f "$p/stack.yaml" ] ;;
    dist-newstyle)        [ -f "$p/cabal.project" ] || any "$p"/*.cabal ;;
    elm-stuff)            [ -f "$p/elm.json" ] ;;
    bin|obj)              any "$p"/*.csproj || any "$p"/*.fsproj || any "$p"/*.vbproj ;;
    Library|Temp)         [ -f "$p/Assembly-CSharp.csproj" ] ;;                      # Unity
    Binaries|Intermediate|DerivedDataCache) any "$p"/*.uproject ;;                   # Unreal
    .godot)               [ -f "$p/project.godot" ] ;;
    .terraform)           [ -f "$p/.terraform.lock.hcl" ] ;;
    .pixi)                [ -f "$p/pixi.toml" ] ;;
    .venv|venv)           [ -f "$p/$1/pyvenv.cfg" ] && { [ -f "$p/pyproject.toml" ] || [ -f "$p/requirements.txt" ] ||
                            [ -f "$p/Pipfile" ] || [ -f "$p/setup.py" ]; } ;;              # a real virtualenv you can recreate
    *) return 0 ;;       # Python bytecode and tool caches: always safe
  esac
}

# Was any source file in project $1 edited in the last $2 days? (Build folders and hidden folders don't count.)
active() {
  local n x=()
  for n in $BUILD_NAMES; do x+=(-o -name "$n"); done
  [ -n "$(find "$1" -mindepth 1 -maxdepth 3 \( -name '.*' "${x[@]}" \) -prune -o -type f -mtime -"$2" -print -quit 2>/dev/null)" ]
}

project_builds() {
  local n x=() prev= grp=() name d p kept=0 tracked=0
  [ ${#ROOTS[@]} -gt 0 ] || return
  for n in $BUILD_NAMES; do x+=(-o -name "$n"); done
  while IFS=$'\t' read -r name d; do
    p=${d%/*}
    owned "$name" "$p" || continue
    case $PY_CACHES in *" $name "*) ;;
      *) if [ "$OLDER" -gt 0 ] && active "$p" "$OLDER"; then kept=$((kept + 1)); continue; fi
         if command -v git >/dev/null && [ -n "$(git -C "$p" ls-files -- "$name" 2>/dev/null | head -1)" ]; then
           tracked=$((tracked + 1)); continue     # committed to git: deleting it would dirty the repo
         fi
         # Your own data inside: a nested git repo, or keys (Solana/Anchor keeps program keys in target/deploy).
         if [ -n "$(find "$d" -maxdepth 3 \( -name .git -o -name '*-keypair.json' \) -print -quit 2>/dev/null)" ]; then
           tracked=$((tracked + 1)); continue
         fi ;;
    esac
    if [ "$name" != "$prev" ] && [ ${#grp[@]} -gt 0 ]; then item "$prev (${#grp[@]})" "${grp[@]}"; grp=(); fi
    prev=$name; grp+=("$d")
  done < <(find "${ROOTS[@]}" -type d \( "${x[@]:1}" \) -print -prune \
             -o -type d \( -name '.*' -o -path "$HOME/Library" \) -prune 2>/dev/null | awk -F/ '{print $NF "\t" $0}' | sort)
  [ ${#grp[@]} -gt 0 ] && item "$prev (${#grp[@]})" "${grp[@]}"
  [ $kept -gt 0 ] && KEPT_NOTE="$kept build folders kept: their projects were edited in the last $OLDER days (--older 0 to include them)"
  [ $tracked -gt 0 ] && KEPT_NOTE="${KEPT_NOTE:+$KEPT_NOTE; }$tracked kept because they are in git or hold a repo or keys"
}

